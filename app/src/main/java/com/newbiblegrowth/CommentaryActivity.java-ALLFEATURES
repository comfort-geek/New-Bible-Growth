package com.newbiblegrowth;
import android.content.*; import android.database.Cursor; import android.graphics.Color; import android.os.Bundle; import android.widget.*; import androidx.appcompat.app.AppCompatActivity; import androidx.recyclerview.widget.*;
import java.util.*;
public class CommentaryActivity extends AppCompatActivity {
    DatabaseHelper db; int bookId, chapter, fontSize=18; boolean night=false;
    RecyclerView recycler; List<Map<String,String>> data=new ArrayList<>();
    protected void onCreate(Bundle s){
        super.onCreate(s); setContentView(R.layout.activity_commentary);
        bookId=getIntent().getIntExtra("book_id",59); chapter=getIntent().getIntExtra("chapter",1);
        db=new DatabaseHelper(this);
        SharedPreferences pref=getSharedPreferences("settings",MODE_PRIVATE); fontSize=pref.getInt("fontSize",18); night=pref.getBoolean("night",false);
        TextView bar=findViewById(R.id.barTitle); bar.setText(db.getBookName(bookId)+" "+chapter);
        recycler=findViewById(R.id.recycler); recycler.setLayoutManager(new LinearLayoutManager(this));
        loadData();
        findViewById(R.id.btnBack).setOnClickListener(v->finish());
        findViewById(R.id.btnFontPlus).setOnClickListener(v->{fontSize++; pref.edit().putInt("fontSize",fontSize).apply(); loadData();});
        findViewById(R.id.btnFontMinus).setOnClickListener(v->{if(fontSize>12)fontSize--; pref.edit().putInt("fontSize",fontSize).apply(); loadData();});
        findViewById(R.id.btnNight).setOnClickListener(v->{night=!night; pref.edit().putBoolean("night",night).apply(); applyNight(); loadData();});
        applyNight();
        // Save recent
        db.getWritableDatabase().execSQL("INSERT OR REPLACE INTO recent_reads(book_id,chapter) VALUES(?,?)", new Object[]{bookId,chapter});
        // Swipe
        recycler.setOnTouchListener(new OnSwipeListener(this){public void onSwipeLeft(){chapter++; bar.setText(db.getBookName(bookId)+" "+chapter); loadData();} public void onSwipeRight(){if(chapter>1){chapter--; bar.setText(db.getBookName(bookId)+" "+chapter); loadData();}}});
    }
    void applyNight(){findViewById(R.id.root).setBackgroundColor(night?Color.BLACK:Color.WHITE);}
    void loadData(){data.clear(); Cursor c=db.getCommentary(bookId,chapter); while(c.moveToNext()){Map<String,String> m=new HashMap<>(); m.put("title",c.getString(1)); m.put("content",c.getString(2)); data.add(m);} c.close(); recycler.setAdapter(new CommentaryAdapter());}
    class CommentaryAdapter extends RecyclerView.Adapter<RecyclerView.ViewHolder>{
        public int getItemCount(){return data.size();}
        public RecyclerView.ViewHolder onCreateViewHolder(android.view.ViewGroup p,int t){return new RecyclerView.ViewHolder(getLayoutInflater().inflate(R.layout.item_commentary,p,false)){ }{};}
        public void onBindViewHolder(RecyclerView.ViewHolder h,int pos){
            TextView title=h.itemView.findViewById(R.id.title); TextView content=h.itemView.findViewById(R.id.content);
            title.setText(data.get(pos).get("title")); content.setText(data.get(pos).get("content"));
            title.setTextSize(fontSize+2); content.setTextSize(fontSize);
            title.setTextColor(night?Color.WHITE:Color.BLACK); content.setTextColor(night?Color.LTGRAY:Color.DKGRAY);
            h.itemView.findViewById(R.id.btnBookmark).setOnClickListener(v->{db.getWritableDatabase().execSQL("INSERT INTO user_bookmarks(book_id,chapter,section_title) VALUES(?,?,?)", new Object[]{bookId,chapter,data.get(pos).get("title")}); Toast.makeText(CommentaryActivity.this,"Bookmarked!",0).show();});
            h.itemView.findViewById(R.id.btnNote).setOnClickListener(v->{EditText et=new EditText(CommentaryActivity.this); new android.app.AlertDialog.Builder(CommentaryActivity.this).setTitle("Add Note").setView(et).setPositiveButton("Save",(d,w)->{db.getWritableDatabase().execSQL("INSERT INTO user_notes(book_id,chapter,section_title,note) VALUES(?,?,?,?)", new Object[]{bookId,chapter,data.get(pos).get("title"),et.getText().toString()});}).show();});
            h.itemView.findViewById(R.id.btnShare).setOnClickListener(v->{Intent i=new Intent(Intent.ACTION_SEND); i.setType("text/plain"); i.putExtra(Intent.EXTRA_TEXT,data.get(pos).get("title")+"\n\n"+data.get(pos).get("content")); startActivity(Intent.createChooser(i,"Share"));});
            // Highlight on long press
            content.setOnLongClickListener(v->{v.setBackgroundColor(Color.YELLOW); Toast.makeText(CommentaryActivity.this,"Highlighted!",0).show(); return true;});
        }
    }
    // Simple swipe detector
    static abstract class OnSwipeListener implements android.view.View.OnTouchListener{float x1; android.content.Context ctx; OnSwipeListener(Context c){ctx=c;} public abstract void onSwipeLeft(); public abstract void onSwipeRight(); public boolean onTouch(android.view.View v, android.view.MotionEvent e){if(e.getAction()==0)x1=e.getX(); if(e.getAction()==1){float x2=e.getX(); if(x2-x1<-100)onSwipeLeft(); if(x2-x1>100)onSwipeRight();} return false;}}
}