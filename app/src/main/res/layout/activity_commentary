<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="50dp" android:orientation="horizontal" android:background="#2C3E50" android:gravity="center_vertical">
        <Button android:id="@+id/btnBack" android:text="<" android:layout_width="50dp" android:layout_height="match_parent"/>
        <TextView android:id="@+id/barTitle" android:text="James 2" android:textColor="#FFFFFF" android:fontFamily="serif" android:textStyle="bold" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
        <Button android:id="@+id/btnFontMinus" android:text="A-" android:layout_width="50dp" android:layout_height="match_parent"/>
        <Button android:id="@+id/btnFontPlus" android:text="A+" android:layout_width="50dp" android:layout_height="match_parent"/>
        <Button android:id="@+id/btnNight" android:text="Night" android:layout_width="60dp" android:layout_height="match_parent"/>
    </LinearLayout>
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/recycler" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="16dp"/>
</LinearLayout>