<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:orientation="vertical"
  android:layout_width="match_parent"
  android:layout_height="match_parent">

  <ProgressBar android:id="@+id/progressBar" style="?android:attr/progressBarStyleHorizontal"
    android:layout_width="match_parent" android:layout_height="wrap_content"/>

  <TextView android:id="@+id/status"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:padding="8dp" android:text="Downloading..."/>

  <ScrollView android:layout_width="match_parent" android:layout_height="120dp">
    <LinearLayout android:id="@+id/gridBooks" android:orientation="vertical"
      android:layout_width="match_parent" android:layout_height="wrap_content"/>
  </ScrollView>

  <WebView android:id="@+id/webView"
    android:layout_width="match_parent" android:layout_height="match_parent"/>
</LinearLayout>