<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
 android:orientation="vertical" android:layout_width="match_parent" android:layout_height="match_parent">
 <ProgressBar android:id="@+id/progressBar" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="wrap_content"/>
 <TextView android:id="@+id/status" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:padding="10dp"/>
 <ScrollView android:layout_width="match_parent" android:layout_height="100dp" android:background="#f5f5f5">
   <GridLayout android:id="@+id/gridBooks" android:layout_width="match_parent" android:layout_height="wrap_content" android:columnCount="3"/>
 </ScrollView>
 <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Swipe LEFT = Next Chapter, Swipe RIGHT = Prev Chapter" android:textSize="11sp" android:gravity="center" android:padding="4dp" android:background="#e8f0fe"/>
 <WebView android:id="@+id/webView" android:layout_width="match_parent" android:layout_height="match_parent"/>
</LinearLayout>