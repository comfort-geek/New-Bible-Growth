<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="12dp">
    <TextView android:text="Enduring Word Commentary" android:textSize="22sp" android:textStyle="bold" android:fontFamily="serif" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="12dp"/>
    <EditText android:id="@+id/search" android:hint="Search commentary..." android:layout_width="match_parent" android:layout_height="50dp" android:background="@android:drawable/edit_text"/>
    <TextView android:id="@+id/recentText" android:text="Recent: None" android:fontFamily="serif" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="8dp"/>
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/bookList" android:layout_width="match_parent" android:layout_height="match_parent"/>
</LinearLayout>